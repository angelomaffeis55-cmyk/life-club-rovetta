{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_title": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "confirmation_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled",
        "checked_in"
      ],
      "default": "confirmed"
    }
  },
  "required": [
    "event_id",
    "full_name",
    "email",
    "quantity"
  ]
}